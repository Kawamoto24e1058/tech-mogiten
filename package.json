{
  "name": "tech-mogiten",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dev-vars.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.cjs && node scripts/e2e-offline.cjs",
    "dev:club": "node scripts/ensure-dev-vars.mjs && CLOUDFLARE_ENV=club VITE_CLUB=1 vite --port 5174",
    "build:club": "tsc -b && CLOUDFLARE_ENV=club VITE_CLUB=1 vite build",
    "deploy:club": "npm run build:club && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/workers-types": "^5.20261001.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.165.0"
  }
}
