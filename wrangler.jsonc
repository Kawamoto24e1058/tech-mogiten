{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-mogiten",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    // npm run build で作られる画面のファイル。ビルド後の設定を経由しない
    // 「npx wrangler deploy」単体でも公開できるように明記しておく
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SHOPS": "a,b"
  },
  "durable_objects": {
    "bindings": [{ "name": "SHOP", "class_name": "ShopDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopDO"] }],
  "observability": { "enabled": true }
}
